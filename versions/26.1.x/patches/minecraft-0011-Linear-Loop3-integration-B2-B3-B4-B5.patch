@@ -1274,9 +1274,16 @@ public final class MoonriseRegionFileIO {
                 // Paper start - flush regionfiles on save
                 if (this.world.paperConfig().chunks.flushRegionsOnSave) {
                     final AbstractRegionFile regionFile = this.regionDataController.getCache().moonrise$getRegionFileIfLoaded(this.chunkX, this.chunkZ); // Linear - widened (flush() is on the interface)
-                    if (regionFile != null) {
-                        regionFile.flush();
-                    } // else: evicted from cache, which should have called flush
+                    // Linear - L3-B3: coordinator-aware batching. Anvil keeps the
+                    // per-write flush() (byte-identical). Linear skips it: the write
+                    // path above already markDirty'd the file, and a per-chunk
+                    // full-file zstd rewrite is write amplification (up to 1024x per
+                    // region per cycle). Durability via RegionFileStorage.flush() ->
+                    // flushDirty() at save-cycle end, bound backpressure, evict().
+                    if (regionFile instanceof net.minecraft.world.level.chunk.storage.RegionFile anvilFile) {
+                        anvilFile.flush();
+                    } // else if Linear: deferred to LinearFlushCoordinator
+                    // else (null): evicted from cache, which should have called flush
                 }
                 // Paper end - flush regionfiles on save
             } catch (final Throwable thr) {
diff --git a/net/linear/AbstractRegionFileFactory.java b/net/linear/AbstractRegionFileFactory.java
