+        // any r.*.linear present means LINEAR, else ANVIL (unchanged). The format flows
+        // via ctor params into the write-side IOWorker/RegionFileStorage, which creates
+        // r.X.Z.<ext> via AbstractRegionFileFactory (see 0001).
+        final net.linear.RegionFileFormat writeFormat = probeWriteFormat(regionFolder);
         return (SimpleRegionStorage)(this.recreateRegionFiles
