+            // Linear L3-B2 (FORCEWRITE): Linear buffers writes in RAM and only
+            // materialises the new_<folder> file on flush. Persist BEFORE the move,
+            // or the move sees a stale/missing file and close() deletes the work.
+            if (this.storage instanceof RecreatingSimpleRegionStorage recreating) {
+                recreating.synchronizeWriteSide(true).join();
+            }
 
             Path filePath = fileToUpgrade.path();
             Path directoryPath = filePath.getParent();
+            // Linear L3-B2 (recreate format): the write side creates in the probed
+            // format, so the new file may carry a different extension than the source
+            // (mca -> linear on a LINEAR world; unchanged on ANVIL). Resolve both.
             Path newFilePath = resolveRecreateDirectory(directoryPath).resolve(filePath.getFileName().toString());
+            Path newLinearPath = replaceExtension(newFilePath, ".mca", ".linear");
+            Path newAnvilPath = replaceExtension(newFilePath, ".linear", ".mca");
+            Path actualNew = null;
+            if (newFilePath.toFile().exists()) {
+                actualNew = newFilePath;
+            } else if (newLinearPath.toFile().exists()) {
+                actualNew = newLinearPath;
+            } else if (newAnvilPath.toFile().exists()) {
+                actualNew = newAnvilPath;
+            }
 
             try {
-                if (newFilePath.toFile().exists()) {
-                    Files.delete(filePath);
-                    Files.move(newFilePath, filePath);
+                if (actualNew != null) {
+                    Path finalPath = directoryPath.resolve(actualNew.getFileName().toString());
+                    if (!finalPath.equals(filePath)) {
+                        // Extension changed (mca -> linear or reverse): lay down the new
+                        // file, then remove the stale source so no shadow pair remains
+                        // (dual-read prefers .mca and would hide the converted data).
+                        Files.move(actualNew, finalPath);
+                        Files.deleteIfExists(filePath);
+                    } else {
+                        Files.delete(filePath);
+                        Files.move(actualNew, finalPath);
+                    }
                 } else {
                     LOGGER.error("Failed to replace an old region file. New file {} does not exist.", newFilePath);
                 }
@@ -280,6 +333,16 @@ public class RegionStorageUpgrader {
         }
     }
 
+    // Linear L3-B2: swap a region-file extension (r.X.Z.mca <-> r.X.Z.linear).
+    // Returns the input path unchanged when it carries neither extension.
+    private static Path replaceExtension(final Path file, final String from, final String to) {
+        String name = file.getFileName().toString();
+        if (name.endsWith(from)) {
+            return file.resolveSibling(name.substring(0, name.length() - from.length()) + to);
+        }
+        return file;
+    }
+
     protected static Path resolveRecreateDirectory(final Path directoryPath) {
         return directoryPath.resolveSibling("new_" + directoryPath.getFileName().toString());
     }
