new file mode 100644
index 0000000000000000000000000000000000000000..2f154a5f8cfa75be78383f4133a616e816281ee2 100644
--- /dev/null
+++ b/net/linear/AbstractRegionFileFactory.java
@@ -0,0 +1,105 @@
+package net.linear;
+
+import java.io.IOException;
+import java.nio.file.Path;
+import net.minecraft.world.level.chunk.storage.RegionFile;
+import net.minecraft.world.level.chunk.storage.RegionStorageInfo;
+
+/**
+ * Construction seam between {@code RegionFileStorage} (and the world
+ * upgrader) and the concrete region-file implementations.
+ *
+ * <p>Dispatch rule: file names ending in {@code .linear} produce
+ * {@code net.linear.LinearRegionFile}; anything else takes the vanilla
+ * anvil path ({@code RegionFile}). The 26.1.2 {@code RegionFile} constructor
+ * is {@code (RegionStorageInfo, Path file, Path externalDir, boolean sync)},
+ * so the anvil branch needs the storage folder and the dsync flag.</p>
+ *
+ * <p>Two overloads are provided. The 3-arg form is the exact shared
+ * contract signature ({@code get(Path file, RegionStorageInfo info, int
+ * compressionLevel)}); it derives {@code folder = file.getParent()} and
+ * defaults {@code sync} to {@code false}. Dispatch sites that own a
+ * {@code RegionFileStorage} MUST call the 5-arg form so the anvil branch
+ * inherits the storage's real folder/sync settings.</p>
+ */
+public final class AbstractRegionFileFactory {
+
+    public static final String LINEAR_EXTENSION = ".linear";
+    public static final String ANVIL_EXTENSION = ".mca";
+
+    /** Fallback compression when the configured level is out of range. */
+    public static final int DEFAULT_COMPRESSION_LEVEL = 1;
+    /** Inclusive upper bound (matches Kaiiju 0003 range 1..22). */
+    public static final int MAX_COMPRESSION_LEVEL = 22;
+
+    private AbstractRegionFileFactory() {}
+
+    /**
+     * Contract-exact factory entry point. The Linear file MUST
+     * declare {@code implements net.linear.AbstractRegionFile} for the
+     * {@code *.linear} branch to link.
+     */
+    public static AbstractRegionFile get(Path file, RegionStorageInfo info, int compressionLevel) throws IOException {
+        return get(file, info, file.toAbsolutePath().getParent(), false, compressionLevel);
+    }
+
+    /**
+     * Full factory entry point for storage-owned dispatch. Preferred: pass
+     * {@code this.folder} and {@code this.sync} from {@code RegionFileStorage}.
+     */
+    public static AbstractRegionFile get(
+        Path file, RegionStorageInfo info, Path folder, boolean sync, int compressionLevel
+    ) throws IOException {
+        String fileName = file.getFileName().toString();
+        if (fileName.endsWith(LINEAR_EXTENSION)) {
+            // LinearRegionFile(Path file, int compressionLevel).
+            return new LinearRegionFile(file, clampCompressionLevel(compressionLevel));
+        }
+        Path externalDir = folder != null ? folder : file.toAbsolutePath().getParent();
+        return new RegionFile(info, file, externalDir, sync);
+    }
+
+    /**
+     * Single config-to-storage mapping point. The only place in
+     * NMS that names the config format enum
+     * ({@code io.papermc.paper.configuration.type.RegionFileFormat}).
+     * Call sites (ServerChunkCache, ServerLevel) pass the raw
+     * {@code paperConfig().regionFormat.format} value through here and must
+     * NEVER ternary-match the config enum inline.
+     *
+     * <p>Maps {@code LINEAR -> LINEAR}, everything else ({@code ANVIL},
+     * {@code null} pre-{@code @PostProcess} or direct unit-test calls) to
+     * {@code ANVIL}. Storage {@code INVALID} (legacy {@code fromString})
+     * never crosses this seam. Adding a future format = one arm here plus
+     * the {@code extensionFor}/{@code get} arms in this same file.</p>
+     */
+    public static RegionFileFormat fromConfig(
+        final io.papermc.paper.configuration.type.RegionFileFormat config
+    ) {
+        return config == io.papermc.paper.configuration.type.RegionFileFormat.LINEAR
+            ? RegionFileFormat.LINEAR : RegionFileFormat.ANVIL;
+    }
+
+    /** Extension (with dot) used when creating new region files. */
+    public static String extensionFor(RegionFileFormat format) {
+        return format == RegionFileFormat.LINEAR ? LINEAR_EXTENSION : ANVIL_EXTENSION;
+    }
+
+    /** Config-enum convenience: {@code extensionFor(fromConfig(config))}. */
+    public static String extensionFor(
+        final io.papermc.paper.configuration.type.RegionFileFormat config
+    ) {
+        return extensionFor(fromConfig(config));
+    }
+
+    /**
+     * Defensive clamp only. Validation/ownership of the configured value
+     * belongs to world config; the factory never throws for range errors.
+     */
+    public static int clampCompressionLevel(int level) {
+        if (level < 1 || level > MAX_COMPRESSION_LEVEL) {
+            return DEFAULT_COMPRESSION_LEVEL;
+        }
+        return level;
+    }
+}
