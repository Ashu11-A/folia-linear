@@ -0,0 +1,256 @@
+package io.papermc.paper.command;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.TreeMap;
+import io.papermc.paper.linear.LinearFolderNames;
+import net.linear.LinearFlushCoordinator;
+import net.linear.LinearRegionTimings;
+import net.kyori.adventure.text.Component;
+import net.kyori.adventure.text.format.NamedTextColor;
+import net.kyori.adventure.text.format.TextDecoration;
+import org.bukkit.Bukkit;
+import org.bukkit.command.Command;
+import org.bukkit.command.CommandSender;
+import org.jetbrains.annotations.NotNull;
+
+/**
+ * Linear linearstats: pull-only Adventure panel.
+ *
+ * <p>Coloured, aligned per-world panel: {@code region|poi|entities} sections
+ * grouped by world, human units (MiB/ms/s), dirty-depth bar, per-world
+ * compression level (from world config) + time-since-last-flush (from the
+ * minecraft-0015 counters), TOTALS footer. Empty state keeps the exact legacy
+ * line. Permission stays {@code linear.command.linearstats}.</p>
+ *
+ * <p>All values pulled via {@code LinearFlushCoordinator.snapshots()} (zero
+ * new storage fields, no pushes, no extra threads). m0015 already carries
+ * raw/compressed bytes, p50/p99 and millis-since-flush; this wires the
+ * display (no counter gap, command display only).</p>
+ */
+public class CommandLinearStats extends Command {
+
+    public CommandLinearStats(@NotNull String name) {
+        super(name);
+        this.setDescription("Shows Linear region timing stats (per-folder + totals)");
+        this.setUsage("/linearstats");
+        // Permission defaults to OP, mirrored from the tps permission setup.
+        // If the base declares tps in permissions.yml rather than in code,
+        // mirror `linear.command.linearstats` there too.
+        this.setPermission("linear.command.linearstats");
+        this.setPermissionMessage("You do not have permission to use linearstats.");
+    }
+
+    @Override
+    public boolean execute(@NotNull CommandSender sender, @NotNull String commandLabel, @NotNull String[] args) {
+        if (!this.testPermission(sender)) {
+            return false;
+        }
+        Map<String, LinearRegionTimings.LinearFolderSnapshot> snaps = LinearFlushCoordinator.snapshots();
+        if (snaps.isEmpty()) {
+            // Empty state: keep the exact legacy line (tests + docs pin it).
+            sender.sendMessage(Component.text("linearstats: no Linear folders tracked (no linear I/O yet).", NamedTextColor.GRAY));
+            return true;
+        }
+        // Group by world, sorted for stable aligned output.
+        Map<String, Map<String, LinearRegionTimings.LinearFolderSnapshot>> byWorld = new TreeMap<>();
+        Map<String, String> folderKeyByWorldType = new TreeMap<>();
+        for (Map.Entry<String, LinearRegionTimings.LinearFolderSnapshot> e : snaps.entrySet()) {
+            String folder = e.getKey();
+            String world = LinearFolderNames.inferWorld(folder);
+            String type = LinearFolderNames.inferFolderType(folder);
+            byWorld.computeIfAbsent(world, k -> new TreeMap<>()).put(type, e.getValue());
+            folderKeyByWorldType.put(world + "/" + type, folder);
+        }
+
+        long tRead = 0, tReadMicros = 0, tWrite = 0, tWriteMicros = 0, tFlush = 0, tFlushMicros = 0;
+        long tLoad = 0, tFiles = 0, tFail = 0, tRaw = 0, tPacked = 0;
+
+        sender.sendMessage(Component.text("Linear stats (" + snaps.size() + " folders)", NamedTextColor.GOLD, TextDecoration.BOLD));
+        for (Map.Entry<String, Map<String, LinearRegionTimings.LinearFolderSnapshot>> we : byWorld.entrySet()) {
+            String world = we.getKey();
+            // Per-world level (world config) + last-flush age (newest across types).
+            int level = resolveCompressionLevel(world);
+            long newestSince = Long.MAX_VALUE;
+            boolean anyFlushed = false;
+            for (LinearRegionTimings.LinearFolderSnapshot s : we.getValue().values()) {
+                if (s.millisSinceLastFlush() >= 0L) {
+                    anyFlushed = true;
+                    newestSince = Math.min(newestSince, s.millisSinceLastFlush());
+                }
+            }
+            Component header = Component.text(world, NamedTextColor.GOLD, TextDecoration.BOLD)
+                .append(Component.text("  lvl " + (level < 0 ? "?" : level), NamedTextColor.YELLOW))
+                .append(Component.text("  " + (anyFlushed ? "last flush " + humanMillisSince(newestSince) : "never flushed"), NamedTextColor.GRAY));
+            sender.sendMessage(header);
+
+            for (Map.Entry<String, LinearRegionTimings.LinearFolderSnapshot> fe : we.getValue().entrySet()) {
+                String type = fe.getKey();
+                LinearRegionTimings.LinearFolderSnapshot s = fe.getValue();
+                // Row 1: aligned counts (fixed widths for ALIGNED columns).
+                String row1 = String.format("  %-8s r=%-6d (%-7s) w=%-6d (%-7s) f=%-6d (%-7s) l=%d",
+                    "[" + type + "]",
+                    s.read().count(), humanMicros(s.read().avgMicros()),
+                    s.write().count(), humanMicros(s.write().avgMicros()),
+                    s.flush().count(), humanMicros(s.flush().avgMicros()),
+                    s.load().count());
+                sender.sendMessage(Component.text(row1, NamedTextColor.GRAY));
+                // Row 2: files/failures + dirty bar + bytes/ratio + p50/p99 + age.
+                String bar = dirtyBar(s.dirtyDepth(), LinearFlushCoordinator.MAX_DIRTY);
+                String bytes = s.rawBytes() <= 0L ? "no bytes yet"
+                    : humanBytes(s.rawBytes()) + "→" + humanBytes(s.compressedBytes())
+                    + " (" + savedPercent(s.rawBytes(), s.compressedBytes()) + "% saved)";
+                String row2 = String.format("    files=%-5d fail=%-3d dirty %s  %s  p50 %s p99 %s  %s",
+                    s.filesFlushed(), s.failures(), bar, bytes,
+                    humanMicros(s.flushP50Micros()), humanMicros(s.flushP99Micros()),
+                    s.millisSinceLastFlush() < 0L ? "never flushed" : humanMillisSince(s.millisSinceLastFlush()) + " ago");
+                sender.sendMessage(Component.text(row2, s.failures() > 0 ? NamedTextColor.RED : NamedTextColor.GRAY));
+
+                tRead += s.read().count();
+                tReadMicros += s.read().totalMicros();
+                tWrite += s.write().count();
+                tWriteMicros += s.write().totalMicros();
+                tFlush += s.flush().count();
+                tFlushMicros += s.flush().totalMicros();
+                tLoad += s.load().count();
+                tFiles += s.filesFlushed();
+                tFail += s.failures();
+                tRaw += s.rawBytes();
+                tPacked += s.compressedBytes();
+            }
+        }
+        String totalBytes = tRaw <= 0L ? "no bytes yet"
+            : humanBytes(tRaw) + "→" + humanBytes(tPacked) + " (" + savedPercent(tRaw, tPacked) + "% saved)";
+        String totals = String.format("TOTALS: read=%d (%s) write=%d (%s) flush=%d (%s) load=%d files=%d fail=%d folders=%d  %s",
+            tRead, humanMicros(tRead == 0 ? 0 : tReadMicros / tRead),
+            tWrite, humanMicros(tWrite == 0 ? 0 : tWriteMicros / tWrite),
+            tFlush, humanMicros(tFlush == 0 ? 0 : tFlushMicros / tFlush),
+            tLoad, tFiles, tFail, snaps.size(), totalBytes);
+        sender.sendMessage(Component.text(totals, NamedTextColor.GOLD));
+        return true;
+    }
+
+    // Human units (panel display only; counters stay raw micros/bytes).
+
+    static String humanBytes(long bytes) {
+        if (bytes < 0L) {
+            return "—";
+        }
+        if (bytes < 1024L) {
+            return bytes + "B";
+        }
+        double v = bytes / 1024.0;
+        if (v < 1024.0) {
+            return String.format("%.1fKiB", v);
+        }
+        v /= 1024.0;
+        if (v < 1024.0) {
+            return String.format("%.1fMiB", v);
+        }
+        v /= 1024.0;
+        return String.format("%.2fGiB", v);
+    }
+
+    static String humanMicros(long micros) {
+        if (micros < 0L) {
+            return "—";
+        }
+        if (micros < 1000L) {
+            return micros + "us";
+        }
+        double ms = micros / 1000.0;
+        if (ms < 1000.0) {
+            return String.format("%.1fms", ms);
+        }
+        return String.format("%.2fs", ms / 1000.0);
+    }
+
+    static String humanMillisSince(long millis) {
+        if (millis < 0L) {
+            return "never";
+        }
+        if (millis < 1000L) {
+            return millis + "ms";
+        }
+        if (millis < 60_000L) {
+            return String.format("%.1fs", millis / 1000.0);
+        }
+        long m = millis / 60_000L;
+        long s = (millis % 60_000L) / 1000L;
+        return m + "m " + s + "s";
+    }
+
+    static long savedPercent(long raw, long packed) {
+        if (raw <= 0L) {
+            return 0L;
+        }
+        if (packed < 0L) {
+            packed = 0L;
+        }
+        if (packed >= raw) {
+            return 0L;
+        }
+        return (raw - packed) * 100L / raw;
+    }
+
+    static String dirtyBar(int depth, int max) {
+        final int width = 10;
+        int filled = 0;
+        if (max > 0 && depth > 0) {
+            filled = (int) Math.round((double) depth / (double) max * width);
+            if (filled < 1) {
+                filled = 1;
+            }
+            if (filled > width) {
+                filled = width;
+            }
+        }
+        StringBuilder sb = new StringBuilder("[");
+        for (int i = 0; i < width; i++) {
+            sb.append(i < filled ? "█" : "░");
+        }
+        sb.append("] ").append(depth).append("/").append(max);
+        return sb.toString();
+    }
+
+    /**
+     * Per-world compression level without assuming the folder parent equals
+     * the Bukkit world name. Folia stores dimensions at
+     * {@code .../dimensions/minecraft/<id>/region}, so {@code inferWorld}
+     * yields the dimension id ({@code overworld}, {@code the_nether},
+     * {@code the_end}) while {@code Bukkit.getWorld} wants the level name
+     * ({@code smp-test}, {@code smp-test_nether}, ...). Try the direct name
+     * first (legacy layouts), then match
+     * {@code ServerLevel.dimension().identifier().getPath()} across loaded
+     * worlds. Returns -1 (panel {@code ?}) when unresolvable; non-fatal.
+     */
+    private static int resolveCompressionLevel(String worldName) {
+        try {
+            org.bukkit.World direct = Bukkit.getWorld(worldName);
+            if (direct instanceof org.bukkit.craftbukkit.CraftWorld cw) {
+                return cw.getHandle().paperConfig().regionFormat.linear.compressionLevel;
+            }
+            for (org.bukkit.World w : Bukkit.getWorlds()) {
+                if (w instanceof org.bukkit.craftbukkit.CraftWorld cw) {
+                    final String dimPath;
+                    try {
+                        dimPath = cw.getHandle().dimension().identifier().getPath();
+                    } catch (RuntimeException e) {
+                        continue;
+                    }
+                    if (worldName.equals(dimPath)) {
+                        return cw.getHandle().paperConfig().regionFormat.linear.compressionLevel;
+                    }
+                }
+            }
+        } catch (RuntimeException ignored) {
+        }
+        return -1;
+    }
+
+    @Override
+    public @NotNull List<String> tabComplete(@NotNull CommandSender sender, @NotNull String alias, @NotNull String[] args) {
+        return new ArrayList<>();
+    }
+}
