From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: folia-linear-ci <folia-linear-ci@users.noreply.github.com>
Date: Mon, 21 Sep 2026 19:53:04 -0300
Subject: [PATCH] Linear flush bridge call site (minecraft-0019, PATCH8)

Loop-3 (agent 27, PATCH8 bridge half): missing
LinearFlushBridge#notifyFlushSync call site right after flushDirty
drains (NMS, no Plugin on this path; autosave + manual saves funnel
through the coordinator). filesAttempted = snapshot size (>=1,
clean-no-ops already returned), elapsed measured around the barrier.
Sync fire (event stays async-contract); tests without Bukkit stay
silent via catch. Pairs with paper-0013 panel + sync overload.

diff --git a/net/linear/LinearFlushCoordinator.java b/net/linear/LinearFlushCoordinator.java
index 65a574fce3f6da8f6fd2e69163958b44e79409e8..d13a9a61266fdacf8bf32292d56a4182236bf791 100644
--- a/net/linear/LinearFlushCoordinator.java
+++ b/net/linear/LinearFlushCoordinator.java
@@ -337,62 +337,80 @@ public final class LinearFlushCoordinator {
         }
         // Linear - minecraft-0016: <=1 keeps the pre-patch serial loop
         // byte-identical (no pool, no futures, no extra branches in the loop).
-        final int threads = linear$resolveFlushThreads();
-        if (threads <= 1 || snapshot.size() <= 1) {
-            for (AbstractRegionFile file : snapshot) {
-                this.flushOne(file);
-            }
-            return;
-        }
-        // Parallel path (>1): ONE shared pool, caller participates as a worker
-        // and joins before returning (durability barrier). NOT invokeAll
-        // (cancels tasks on interrupt, truncating the barrier); individual
-        // Future.get preserves every task. flushOne already records failures,
-        // so ExecutionException needs no extra counting, just barrier progress.
-        final java.util.concurrent.ExecutorService pool;
+        // Linear - minecraft-0019 (PATCH8, agent 27): missing bridge call site.
+        // Fires LinearRegionFlushCompletedEvent right after flushDirty drains,
+        // via the Paper sync overload (no Plugin on this NMS path; autosave +
+        // manual saves all funnel through here). filesAttempted = snapshot
+        // size (>=1, clean-no-ops already returned above).
+        final long batchStartNanos = System.nanoTime();
+        final int filesAttempted = snapshot.size();
         try {
-            pool = linear$sharedPool(threads);
-        } catch (RuntimeException fallback) {
-            for (AbstractRegionFile file : snapshot) {
-                this.flushOne(file);
+            final int threads = linear$resolveFlushThreads();
+            if (threads <= 1 || snapshot.size() <= 1) {
+                for (AbstractRegionFile file : snapshot) {
+                    this.flushOne(file);
+                }
+                return;
             }
-            return;
-        }
-        final java.util.List<java.util.concurrent.Future<?>> futures =
-            new java.util.ArrayList<>(snapshot.size() - 1);
-        for (int i = 1; i < snapshot.size(); i++) {
-            final AbstractRegionFile f = snapshot.get(i);
+            // Parallel path (>1): ONE shared pool, caller participates as a worker
+            // and joins before returning (durability barrier). NOT invokeAll
+            // (cancels tasks on interrupt, truncating the barrier); individual
+            // Future.get preserves every task. flushOne already records failures,
+            // so ExecutionException needs no extra counting, just barrier progress.
+            final java.util.concurrent.ExecutorService pool;
             try {
-                futures.add(pool.submit(() -> {
-                    this.flushOne(f);
-                    return null;
-                }));
-            } catch (RuntimeException submitFailed) {
-                // Queue/reject fallback: run inline so durability is not lost.
-                this.flushOne(f);
+                pool = linear$sharedPool(threads);
+            } catch (RuntimeException fallback) {
+                for (AbstractRegionFile file : snapshot) {
+                    this.flushOne(file);
+                }
+                return;
             }
-        }
-        // Caller work: first file inline (participation).
-        this.flushOne(snapshot.get(0));
-        boolean interrupted = false;
-        for (java.util.concurrent.Future<?> fut : futures) {
-            while (true) {
+            final java.util.List<java.util.concurrent.Future<?>> futures =
+                new java.util.ArrayList<>(snapshot.size() - 1);
+            for (int i = 1; i < snapshot.size(); i++) {
+                final AbstractRegionFile f = snapshot.get(i);
                 try {
-                    fut.get();
-                    break;
-                } catch (InterruptedException ie) {
-                    // Do NOT cancel others (invokeAll would); keep waiting so
-                    // the barrier is not truncated, re-interrupt at the end.
-                    interrupted = true;
-                } catch (java.util.concurrent.ExecutionException ee) {
-                    break;
-                } catch (RuntimeException re) {
-                    break;
+                    futures.add(pool.submit(() -> {
+                        this.flushOne(f);
+                        return null;
+                    }));
+                } catch (RuntimeException submitFailed) {
+                    // Queue/reject fallback: run inline so durability is not lost.
+                    this.flushOne(f);
                 }
             }
-        }
-        if (interrupted) {
-            Thread.currentThread().interrupt();
+            // Caller work: first file inline (participation).
+            this.flushOne(snapshot.get(0));
+            boolean interrupted = false;
+            for (java.util.concurrent.Future<?> fut : futures) {
+                while (true) {
+                    try {
+                        fut.get();
+                        break;
+                    } catch (InterruptedException ie) {
+                        // Do NOT cancel others (invokeAll would); keep waiting so
+                        // the barrier is not truncated, re-interrupt at the end.
+                        interrupted = true;
+                    } catch (java.util.concurrent.ExecutionException ee) {
+                        break;
+                    } catch (RuntimeException re) {
+                        break;
+                    }
+                }
+            }
+            if (interrupted) {
+                Thread.currentThread().interrupt();
+            }
+        } finally {
+            final long elapsedMicros = (System.nanoTime() - batchStartNanos) / 1000L;
+            try {
+                io.papermc.paper.linear.LinearFlushBridge.notifyFlushSync(
+                    key(this.folder), filesAttempted, elapsedMicros);
+            } catch (RuntimeException | LinkageError ignored) {
+                // Tests without Bukkit, or Paper bridge absent: event stays
+                // silent, durability already complete (barrier joined above).
+            }
         }
     }
 
