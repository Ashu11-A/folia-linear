+        1_000L, 5_000L, 10_000L, 25_000L, 50_000L,
+        100_000L, 250_000L, 500_000L, 1_000_000L, Long.MAX_VALUE};
+    private final LongAdder[] flushBuckets = new LongAdder[]{
+        new LongAdder(), new LongAdder(), new LongAdder(), new LongAdder(), new LongAdder(),
+        new LongAdder(), new LongAdder(), new LongAdder(), new LongAdder(), new LongAdder()};
 
     private LinearFlushCoordinator(Path folder) {
         this.folder = folder;
