+     * Null config yields 0. Test override wins.
+     */
+    static int linear$resolveCompressionWorkers() {
+        Integer override = COMPRESSION_WORKERS_OVERRIDE_FOR_TESTS;
+        if (override != null) {
+            return override;
+        }
+        try {
+            io.papermc.paper.configuration.GlobalConfiguration cfg =
