From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: folia-linear <folia-linear@users.noreply.github.com>
Date: Mon, 21 Sep 2026 00:00:00 +0000
Subject: [PATCH] Linear eviction close outside monitor (minecraft-0014)

Loop-3 (agent 28): move regionCache.removeLast().close() in
moonrise$getRegionFileIfExists / getRegionFile OUTSIDE the monitor.
Level-22 eviction close is a full-region zstd rewrite blocking all I/O
on that folder. Removed `synchronized` from moonrise$getRegionFileIfExists
(explicit block instead); both paths remove-then-close (remove under lock,
close unlocked after). Open-once preserved: put stays under lock, close
only touches the already-removed evicted file.

diff --git a/net/minecraft/world/level/chunk/storage/RegionFileStorage.java b/net/minecraft/world/level/chunk/storage/RegionFileStorage.java
index 231aec0..bb1f045 100644
--- a/net/minecraft/world/level/chunk/storage/RegionFileStorage.java
+++ b/net/minecraft/world/level/chunk/storage/RegionFileStorage.java
@@ -136,17 +136,23 @@ public class RegionFileStorage implements AutoCloseable, ca.spottedleaf.moonrise
     }
 
     @Override
-    public synchronized final AbstractRegionFile moonrise$getRegionFileIfExists(final int chunkX, final int chunkZ) throws IOException { // Linear - widened + dual-read probe
+    public final AbstractRegionFile moonrise$getRegionFileIfExists(final int chunkX, final int chunkZ) throws IOException { // Linear - widened + dual-read probe
+        // Linear - L3-0014: eviction close outside the monitor. Level-22 eviction
+        // close is a full-region zstd rewrite; holding the monitor blocked all
+        // I/O on this folder. Removed `synchronized` from the method signature;
+        // cache accesses stay under an explicit block, close runs unlocked after.
         final long key = ChunkPos.pack(chunkX >> REGION_SHIFT, chunkZ >> REGION_SHIFT);
-
-        AbstractRegionFile ret = this.regionCache.getAndMoveToFirst(key); // Linear L1-TIMING: cache-hit accounting below (no recalc-counter touch)
-        if (ret != null) {
+        AbstractRegionFile evicted = null;
+        final AbstractRegionFile ret;
+        synchronized (this) {
+        AbstractRegionFile hit = this.regionCache.getAndMoveToFirst(key); // Linear L1-TIMING: cache-hit accounting below (no recalc-counter touch)
+        if (hit != null) {
             // Linear L1-TIMING: cache hit (lock-free delegate, zero new fields).
             try {
                 LinearFlushCoordinator.forFolder(this.folder).reportCacheHit();
             } catch (RuntimeException ignored) {
             }
-            return ret;
+            return hit;
         }
         // Linear L1-TIMING: cache miss (lock-free delegate, zero new fields).
         try {
@@ -161,7 +167,7 @@ public class RegionFileStorage implements AutoCloseable, ca.spottedleaf.moonrise
         final int cacheSize = io.papermc.paper.configuration.GlobalConfiguration.get() == null ? 256 : io.papermc.paper.configuration.GlobalConfiguration.get().misc.regionFileCacheSize; // Paper - Sanitise RegionFileCache and make configurable - Config not available during initial FileFixerUpper run
 
         if (this.regionCache.size() >= cacheSize) {
-            this.regionCache.removeLast().close();
+            evicted = this.regionCache.removeLast(); // Linear - L3-0014: close outside (see below)
         }
 
         // Linear - dual-read probe: .mca preferred, else .linear. The negative cache
@@ -183,10 +189,14 @@ public class RegionFileStorage implements AutoCloseable, ca.spottedleaf.moonrise
         FileUtil.createDirectoriesSafe(this.folder);
 
         this.guardAgainstBrokenSymlinks(regionPath); // Linear B2 - existingOnly probe call site
-        ret = AbstractRegionFileFactory.get(regionPath, this.info, this.folder, this.sync, this.compressionLevel); // Linear - open in probed format
-
-        this.regionCache.putAndMoveToFirst(key, ret);
+        AbstractRegionFile opened = AbstractRegionFileFactory.get(regionPath, this.info, this.folder, this.sync, this.compressionLevel); // Linear - open in probed format
 
+        this.regionCache.putAndMoveToFirst(key, opened);
+        ret = opened;
+        }
+        if (evicted != null) {
+            evicted.close(); // Linear - L3-0014: unlocked (full rewrite safe outside monitor)
+        }
         return ret;
     }
 
@@ -402,17 +412,22 @@ public class RegionFileStorage implements AutoCloseable, ca.spottedleaf.moonrise
         if (existingOnly) {
             return this.moonrise$getRegionFileIfExists(pos.x(), pos.z());
         }
+        // Linear - L3-0014: eviction close outside the monitor (same rationale
+        // as moonrise$getRegionFileIfExists above: level-22 close is a full
+        // rewrite blocking all I/O on this folder).
+        AbstractRegionFile evicted = null;
+        final AbstractRegionFile ret;
         synchronized (this) {
             final long key = ChunkPos.pack(pos.x() >> REGION_SHIFT, pos.z() >> REGION_SHIFT);
 
-            AbstractRegionFile ret = this.regionCache.getAndMoveToFirst(key);
-            if (ret != null) {
+            AbstractRegionFile hit = this.regionCache.getAndMoveToFirst(key);
+            if (hit != null) {
                 // Linear L1-TIMING: cache hit (lock-free delegate, zero new fields).
                 try {
                     LinearFlushCoordinator.forFolder(this.folder).reportCacheHit();
                 } catch (RuntimeException ignored) {
                 }
-                return ret;
+                return hit;
             }
             // Linear L1-TIMING: cache miss (lock-free delegate, zero new fields).
             try {
@@ -423,7 +438,7 @@ public class RegionFileStorage implements AutoCloseable, ca.spottedleaf.moonrise
             final int cacheSize = io.papermc.paper.configuration.GlobalConfiguration.get() == null ? 256 : io.papermc.paper.configuration.GlobalConfiguration.get().misc.regionFileCacheSize; // Paper - Sanitise RegionFileCache and make configurable - Config not available during initial FileFixerUpper run
 
             if (this.regionCache.size() >= cacheSize) {
-                this.regionCache.removeLast().close();
+                evicted = this.regionCache.removeLast(); // Linear - L3-0014: close outside (see below)
             }
 
             // Linear - create in the storage's configured format (default ANVIL).
@@ -434,12 +449,15 @@ public class RegionFileStorage implements AutoCloseable, ca.spottedleaf.moonrise
             FileUtil.createDirectoriesSafe(this.folder);
 
             this.guardAgainstBrokenSymlinks(regionPath); // Linear B2 - write-path creation call site
-            ret = AbstractRegionFileFactory.get(regionPath, this.info, this.folder, this.sync, this.compressionLevel); // Linear - factory dispatch
-
-            this.regionCache.putAndMoveToFirst(key, ret);
+            AbstractRegionFile opened = AbstractRegionFileFactory.get(regionPath, this.info, this.folder, this.sync, this.compressionLevel); // Linear - factory dispatch
 
-            return ret;
+            this.regionCache.putAndMoveToFirst(key, opened);
+            ret = opened;
         }
+        if (evicted != null) {
+            evicted.close(); // Linear - L3-0014: unlocked
+        }
+        return ret;
         // Paper end - rewrite chunk system
     }
 
