@@ -0,0 +1,94 @@
+package io.papermc.paper.command;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import io.papermc.paper.linear.SexidiumLinearFolderNames;
+import net.sexidium.LinearFlushCoordinator;
+import net.sexidium.LinearRegionTimings;
+import org.bukkit.command.Command;
+import org.bukkit.command.CommandSender;
+import org.jetbrains.annotations.NotNull;
+
+/**
+ * Sexidium linearstats: pull-only timing readout (L2-STATS).
+ *
+ * <p>Shape mirrors {@code CommandServerHealth} (assumed Bukkit Command with
+ * ctor/execute/empty-tabComplete; relocate package to match its real location
+ * if different — see patch header A2). Permission
+ * {@code sexidium.command.linearstats} defaults to OP, mirrored from the tps
+ * permission setup (see base tps wiring; integrator must mirror the
+ * permissions.yml/default-OP entry if base declares tps there rather than in
+ * code).</p>
+ *
+ * <p>Output: one row per storage folder (world + folderType pinned to
+ * {@code region|poi|entities} via {@code SexidiumLinearFolderNames},
+ * default {@code region}) with read/write/flush counts+avgs, load
+ * count, filesFlushed, dirtyDepth, failures — plus a TOTALS row. All values
+ * are pulled via {@code LinearFlushCoordinator.snapshots()} /
+ * {@code RegionFileStorage#sexidium$stats()} (zero new storage fields, no
+ * pushes, no extra threads). Granularity is flush-granularity (event fires
+ * once per {@code flushDirty()} with {@code >=1} file attempted; clean-no-ops
+ * fire nothing).</p>
+ */
+public class CommandLinearStats extends Command {
+
+    public CommandLinearStats(@NotNull String name) {
+        super(name);
+        this.setDescription("Shows Linear region timing stats (per-folder + totals)");
+        this.setUsage("/linearstats");
+        // Sexidium: permission default OP, mirrored from tps (A2 assumption).
+        // If base declares tps in permissions.yml/default-OP (not in code),
+        // integrator must mirror `sexidium.command.linearstats` there too.
+        this.setPermission("sexidium.command.linearstats");
+        this.setPermissionMessage("You do not have permission to use linearstats.");
+    }
+
+    @Override
+    public boolean execute(@NotNull CommandSender sender, @NotNull String commandLabel, @NotNull String[] args) {
+        if (!this.testPermission(sender)) {
+            return false;
+        }
+        Map<String, LinearRegionTimings.LinearFolderSnapshot> snaps = LinearFlushCoordinator.snapshots();
+        if (snaps.isEmpty()) {
+            sender.sendMessage("linearstats: no Linear folders tracked (no linear I/O yet).");
+            return true;
+        }
+        long tRead = 0, tReadMicros = 0, tWrite = 0, tWriteMicros = 0, tFlush = 0, tFlushMicros = 0;
+        long tLoad = 0, tFiles = 0, tFail = 0;
+        for (Map.Entry<String, LinearRegionTimings.LinearFolderSnapshot> e : snaps.entrySet()) {
+            String folder = e.getKey();
+            LinearRegionTimings.LinearFolderSnapshot s = e.getValue();
+            String folderType = SexidiumLinearFolderNames.inferFolderType(folder);
+            String world = SexidiumLinearFolderNames.inferWorld(folder);
+            sender.sendMessage(String.format(
+                "%s [%s]: read=%d (avg %d us) write=%d (avg %d us) flush=%d (avg %d us) load=%d filesFlushed=%d dirtyDepth=%d failures=%d",
+                world, folderType,
+                s.read().count(), s.read().avgMicros(),
+                s.write().count(), s.write().avgMicros(),
+                s.flush().count(), s.flush().avgMicros(),
+                s.load().count(), s.filesFlushed(), s.dirtyDepth(), s.failures()));
+            tRead += s.read().count();
+            tReadMicros += s.read().totalMicros();
+            tWrite += s.write().count();
+            tWriteMicros += s.write().totalMicros();
+            tFlush += s.flush().count();
+            tFlushMicros += s.flush().totalMicros();
+            tLoad += s.load().count();
+            tFiles += s.filesFlushed();
+            tFail += s.failures();
+        }
+        sender.sendMessage(String.format(
+            "TOTALS: read=%d (avg %d us) write=%d (avg %d us) flush=%d (avg %d us) load=%d filesFlushed=%d failures=%d folders=%d",
+            tRead, tRead == 0 ? 0 : tReadMicros / tRead,
+            tWrite, tWrite == 0 ? 0 : tWriteMicros / tWrite,
+            tFlush, tFlush == 0 ? 0 : tFlushMicros / tFlush,
+            tLoad, tFiles, tFail, snaps.size()));
+        return true;
+    }
+
+    @Override
+    public @NotNull List<String> tabComplete(@NotNull CommandSender sender, @NotNull String alias, @NotNull String[] args) {
+        return new ArrayList<>();
+    }
+}
